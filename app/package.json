{
  "name": "tablemap",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first battle map for tabletop games: a DM window and a player window for the TV.",
  "author": "TableMap contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tenacioustechie/tablemap.git"
  },
  "main": "electron/main.mjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint src e2e",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "fixture:grid": "node scripts/make-grid-fixture.mjs",
    "desktop": "npm run build && electron .",
    "desktop:dist": "npm run build && electron-builder --publish never",
    "desktop:smoke": "node scripts/desktop-smoke.mjs"
  },
  "dependencies": {
    "dexie": "^4.0.8",
    "electron-updater": "^6.8.11",
    "jszip": "^3.10.1",
    "konva": "^9.3.14",
    "nanoid": "^5.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "react-router-dom": "^6.26.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.46.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "eslint": "^9.9.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^24.1.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  },
  "build": {
    "appId": "io.github.tablemap",
    "productName": "TableMap",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*.mjs",
      "package.json"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.games",
      "identity": "-",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "tenacioustechie",
        "repo": "tablemap",
        "releaseType": "release"
      }
    ]
  }
}
